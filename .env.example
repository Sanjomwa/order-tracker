# Copy to .env (gitignored) and set a real password before starting the stack:
#   cp .env.example .env && sed -i "s|^GRAFANA_ADMIN_PASSWORD=.*|GRAFANA_ADMIN_PASSWORD=$(openssl rand -base64 24)|" .env
# Without .env, Grafana falls back to its own default admin password (admin);
# the stack only listens on 127.0.0.1. The password is applied when Grafana's data
# volume is first created; changing it later needs `grafana cli admin reset-admin-password`.
GRAFANA_ADMIN_PASSWORD=change-me

# Set to true to also print spans, metrics and logs to `docker compose logs app` (Q2).
OTEL_CONSOLE_EXPORT=false
